# ============================================================
# Obsidian RAG — Environment Configuration (TEMPLATE)
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
#   cp .env.example .env
# ห้าม commit ไฟล์ .env ขึ้น Git เด็ดขาด (มีอยู่ใน .gitignore แล้ว)
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=pPp31072001!@
POSTGRES_DB=obsidian_rag
POSTGRES_PORT=5432

# ---------- Qdrant ----------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# เว้นว่างไว้ได้ตอน dev บนเครื่องตัวเอง — ตอน deploy จริง (Phase 5) ต้องใส่
QDRANT_API_KEY=
QDRANT_COLLECTION=obsidian_notes

# ---------- Ollama ----------
# รันบน Windows host, เรียกจากในเครื่อง (WSL) โดยตรง:
OLLAMA_BASE_URL=http://localhost:11434
# ถ้า FastAPI ถูกย้ายเข้าไปรันใน container (Phase 4-5) ให้เปลี่ยนเป็น:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
# bge-m3 คืนเวกเตอร์ขนาด 1024 มิติ — ต้องตรงกับตอนสร้าง collection ใน Qdrant
EMBED_DIM=1024

# ---------- Obsidian Vault ----------
# path ของ vault เมื่อมองจาก WSL (ถ้า vault อยู่บน Windows drive C:)
# ตัวอย่าง: /mnt/c/Users/thanutsu/Documents/MyVault
OBSIDIAN_VAULT_PATH=/mnt/c/Users/Thanu/Desktop/PP/RAG/Rag

# ---------- RAG Parameters ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
